{
  "expo": {
    "name": "Tomer Dahan Jewelry",
    "slug": "tomer-dahan-jewelry",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tomerdahan",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tomerdahan.jewelry"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.tomerdahan.jewelry"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
