# WhatsApp alert secrets. Copy to ".env" and fill in, then in your shell:  . ./.env
# (".env" is gitignored — keep your keys out of version control.)

# --- CallMeBot (free, personal — see README "Option A") ---
# Get this by messaging the CallMeBot WhatsApp number the activation phrase.
export CALLMEBOT_APIKEY=

# --- Twilio (only if provider is "twilio" — see README "Option B") ---
# export TWILIO_ACCOUNT_SID=
# export TWILIO_AUTH_TOKEN=
# export TWILIO_FROM=+14155238886
# export TWILIO_TO=+972500000000
